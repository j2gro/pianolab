# Copy to `.env` in the repo root (`scripts/home-serve.ps1` does this for you).

HOST=0.0.0.0
PORT=8443
STATIC_DIR=apps/web/dist
SESSION_SECRET=replace-me

# Neon (required on Vercel). Use the pooled URI. Local/home LAN use file store when unset.
# DATABASE_URL=postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/neondb?sslmode=require

# HTTPS via mkcert (scripts/home-serve.ps1 writes these when mkcert is installed)
TLS_CERT=certs/lan.pem
TLS_KEY=certs/lan-key.pem

# Optional. Default with STATIC_DIR is to reflect the browser Origin.
# CORS_ORIGIN=https://192.168.1.10:8443
