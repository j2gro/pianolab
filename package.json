{
  "name": "pianolab",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:web": "npm run dev -w @pianolab/web",
    "dev:api": "npm run dev -w @pianolab/api",
    "start:home": "npm run start -w @pianolab/api",
    "home:serve": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/home-serve.ps1",
    "home:install": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/install-home-task.ps1",
    "home:uninstall": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/uninstall-home-task.ps1",
    "vercel-build": "node scripts/vercel-build.mjs",
    "build": "npm run build --workspaces --if-present",
    "lint": "oxlint .",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "lesson:import": "npm run import-midi -w @pianolab/lesson-schema --",
    "lesson:ingest-mxl": "npm run ingest-mxl -w @pianolab/lesson-schema --"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "oxlint": "^1.81.0",
    "tsx": "^4.20.5",
    "typescript": "~6.0.2"
  },
  "overrides": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "engines": {
    "node": ">=20.19"
  }
}
